{
  "name": "dsh-ios",
  "version": "0.1.0",
  "description": "DSH 的 iOS 版：agent 循环与工具全部跑在 iPhone 本地，直连模型 API，不依赖电脑或服务器",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "parity": "tsx scripts/parity.mts",
    "test": "tsx scripts/test-agent.mts && tsx scripts/test-events.mts && tsx scripts/test-store.mts && tsx scripts/test-search.mts && tsx scripts/test-mcp.mts && tsx scripts/test-sandbox.mts",
    "test:agent": "tsx scripts/test-agent.mts",
    "test:events": "tsx scripts/test-events.mts",
    "test:store": "tsx scripts/test-store.mts",
    "test:search": "tsx scripts/test-search.mts",
    "test:mcp": "tsx scripts/test-mcp.mts",
    "test:sandbox": "tsx scripts/test-sandbox.mts",
    "serve:exec": "node server/exec-agent.mjs",
    "serve:search": "node server/search-agent.mjs"
  },
  "private": true
}
